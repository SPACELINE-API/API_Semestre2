<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="" stylesheets="@../../../Css/principal.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.sputnik.api.mostrarOHistórico">
   <top>
      <AnchorPane fx:id="topPane" nodeOrientation="LEFT_TO_RIGHT" onMouseDragged="#movimento" onMousePressed="#click" style="-fx-background-color: #023c57;" BorderPane.alignment="TOP_RIGHT">
         <children>
            <HBox alignment="TOP_RIGHT" layoutX="607.0" layoutY="1.0" nodeOrientation="RIGHT_TO_LEFT" style="-fx-background-color: #023c57;" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <Button fx:id="btnClose" alignment="TOP_RIGHT" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#fechar" styleClass="clsbtn" stylesheets="@../../../Css/principal.css" text="x" textAlignment="JUSTIFY">
                     <font>
                        <Font name="Inter 18pt Regular" size="18.0" />
                     </font></Button>
                  <Button fx:id="btnTab" mnemonicParsing="false" onAction="#fullscreen" styleClass="tabbtn" stylesheets="@../../../Css/principal.css" text="◱">
                     <font>
                        <Font name="Inter 18pt Regular" size="18.0" />
                     </font></Button>
                  <Button fx:id="btnMinimize" mnemonicParsing="false" onAction="#diminuir" styleClass="dimbtn" stylesheets="@../../../Css/principal.css" text="–">
                     <font>
                        <Font name="Inter 18pt Regular" size="18.0" />
                     </font></Button>
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </top>

   <center>
      <HBox spacing="10.0" style="-fx-padding: 10;" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="tableExplicacoes" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCodExp" minWidth="80.0" prefWidth="-1.0" text="Código" />
                  <TableColumn fx:id="colExplicacao" minWidth="80.0" prefWidth="-1.0" text="Explicação" />
                  <TableColumn fx:id="colDataExp" minWidth="100.0" prefWidth="-1.0" text="Data de Criação" />
               </columns>
            </TableView>

            <TableView fx:id="tableSugestoes" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCodSug" minWidth="80.0" prefWidth="-1.0" text="Código" />
                  <TableColumn fx:id="colSugestao" minWidth="80.0" prefWidth="-1.0" text="Sugestão" />
                  <TableColumn fx:id="colDataSug" minWidth="100.0" prefWidth="-1.0" text="Data de Criação" />
               </columns>
            </TableView>

            <TableView fx:id="tableTraducoes" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCodTrad" minWidth="80.0" prefWidth="-1.0" text="Código" />
                  <TableColumn fx:id="colTraducao" minWidth="80.0" prefWidth="-1.0" text="Tradução" />
                  <TableColumn fx:id="colDataTrad" minWidth="100.0" prefWidth="-1.0" text="Data de Criação" />
               </columns>
            </TableView>
         </children>
      </HBox>

   </center>
</BorderPane>
